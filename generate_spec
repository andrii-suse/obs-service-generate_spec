#!/usr/bin/env python3
"""
obs-service-generate_spec: Umbrella Spec Generator Service for Open Build Service
Auto-detects upstream manifests and invokes language-specific plugins to generate RPM specs.
"""

import argparse
import glob
import os
import re
import subprocess
import sys
import tarfile
from pathlib import Path


GENERATOR_SIGNATURE = "AUTO-GENERATED by obs-service-generate_spec"


def is_our_generated_spec(spec_path: Path) -> bool:
    """Returns True if the spec was previously generated by this service."""
    try:
        content = spec_path.read_text(encoding="utf-8", errors="replace")[:1000]
        return GENERATOR_SIGNATURE in content
    except Exception:
        return False


def check_existing_spec(search_dir: Path) -> str | None:
    """
    Checks if a custom/human-maintained RPM spec file already exists.
    If a spec file contains GENERATOR_SIGNATURE, it is considered a previous run's artifact
    and allowed to be updated/regenerated for a new release.
    """
    search_dirs = [search_dir]
    cwd = Path.cwd().resolve()
    if cwd != search_dir:
        search_dirs.append(cwd)

    # 1. Check directly on disk for plain or service-prefixed specs
    for p in search_dirs:
        for pattern in ["*.spec", "_service:*:*.spec"]:
            for spec_file in p.glob(pattern):
                if is_our_generated_spec(spec_file):
                    print(f"generate_spec: Previous generated spec '{spec_file.name}' found. Allowing update/regeneration.")
                    continue
                # Found a human-maintained or custom spec file
                return spec_file.name

    # 2. Peek inside source archives (e.g. .tar.gz, .tar.xz, .tar.zst)
    for p in search_dirs:
        for archive in list(p.glob("*.tar.*")) + list(p.glob("*.tar")):
            try:
                if tarfile.is_tarfile(archive):
                    with tarfile.open(archive, "r:*") as tar:
                        for member in tar.getmembers():
                            if member.name.endswith(".spec") and not member.name.startswith("vendor/"):
                                f = tar.extractfile(member)
                                if f:
                                    content = f.read(1000).decode("utf-8", errors="replace")
                                    if GENERATOR_SIGNATURE in content:
                                        continue
                                return f"{archive.name}:{member.name}"
            except Exception:
                pass

    return None


def get_plugin_directories(custom_plugin_dir: str | None) -> list[Path]:
    """Returns search directories for plugins in priority order."""
    dirs = []
    if custom_plugin_dir:
        dirs.append(Path(custom_plugin_dir).resolve())

    # System directories
    dirs.append(Path("/etc/obs/service/generate_spec.d"))
    dirs.append(Path("/usr/lib/obs/service/generate_spec.d"))

    # Local development / repository fallback
    script_dir = Path(__file__).parent.resolve()
    dirs.append(script_dir / "generate_spec.d")

    return [d for d in dirs if d.is_dir()]


def collect_plugins(plugin_dirs: list[Path]) -> list[tuple[int, str, Path]]:
    """
    Collects plugins sorted by priority.
    Format of plugin filename: <priority>-<manifest_mask> (e.g. 30-go.mod)
    Supports masking: if an earlier dir has a symlink to /dev/null, it is masked.
    """
    seen = {}
    for pdir in plugin_dirs:
        for item in pdir.iterdir():
            name = item.name
            if name in seen:
                continue

            # Check if masked via /dev/null
            if item.is_symlink() and os.readlink(item) == "/dev/null":
                seen[name] = None
                continue

            # Parse priority
            parts = name.split("-", 1)
            if len(parts) != 2:
                continue

            try:
                prio = int(parts[0])
            except ValueError:
                continue

            manifest_mask = parts[1]
            target_exec = item.resolve()
            if os.access(target_exec, os.X_OK):
                seen[name] = (prio, manifest_mask, target_exec)

    plugins = [p for p in seen.values() if p is not None]
    plugins.sort(key=lambda x: (x[0], x[1]))
    return plugins


def locate_source_directory(source_dir_arg: str | None) -> Path:
    """Finds the directory where the source code is extracted."""
    if source_dir_arg:
        p = Path(source_dir_arg).resolve()
        if p.is_dir():
            return p

    cwd = Path.cwd().resolve()

    # Check if there is an extracted directory from obs_scm / tar_scm
    subdirs = [d for d in cwd.iterdir() if d.is_dir() and not d.name.startswith(".") and d.name != "out"]
    for d in subdirs:
        if (d / "go.mod").is_file() or (d / "Cargo.toml").is_file() or (d / "pyproject.toml").is_file():
            return d

    return cwd


def resolve_version(source_dir: Path, requested_version: str | None) -> str:
    """
    Resolves package version using a 5-tier resolution hierarchy:
    1. Explicit requested version (if not @VERSION@)
    2. OBS SCM metadata (*.obsinfo or _scmsync.obsinfo)
    3. Git repository tags and commits (git describe)
    4. Source archive filename (e.g. croc-10.1.1.tar.gz)
    5. Fallback to @VERSION@
    """
    if requested_version and requested_version != "@VERSION@":
        return requested_version

    # Tier 1: Check *.obsinfo (e.g. _scmsync.obsinfo)
    search_dirs = [source_dir]
    cwd = Path.cwd().resolve()
    if cwd != source_dir:
        search_dirs.append(cwd)

    for p in search_dirs:
        for obsinfo in list(p.glob("*.obsinfo")) + list(p.glob("_scmsync.obsinfo")):
            try:
                for line in obsinfo.read_text(encoding="utf-8", errors="replace").splitlines():
                    if line.startswith("version:"):
                        v = line.split(":", 1)[1].strip()
                        v = re.sub(r"^v", "", v)
                        if v:
                            print(f"generate_spec: Detected version '{v}' from '{obsinfo.name}'.")
                            return v
            except Exception:
                pass

    # Tier 2: Check Git tags / commits if .git directory exists
    git_dir = source_dir / ".git"
    if git_dir.exists():
        try:
            # Check for exact tag match on HEAD
            res = subprocess.run(
                ["git", "describe", "--tags", "--exact-match"],
                cwd=source_dir,
                capture_output=True,
                text=True,
            )
            if res.returncode == 0:
                raw_tag = res.stdout.strip()
                v = re.sub(r"^v", "", raw_tag)
                if v:
                    print(f"generate_spec: Detected exact git tag version '{v}'.")
                    return v

            # Check general git describe (e.g. v11.5.4-20-gb6d9a35f)
            res = subprocess.run(
                ["git", "describe", "--tags", "--always"],
                cwd=source_dir,
                capture_output=True,
                text=True,
            )
            if res.returncode == 0:
                raw_desc = res.stdout.strip()
                m = re.match(r"^v?([0-9]+(?:\.[0-9]+)*)(?:-(\d+)-g([0-9a-f]+))?$", raw_desc)
                if m:
                    base_ver = m.group(1)
                    commits_ahead = m.group(2)
                    git_hash = m.group(3)
                    if commits_ahead and git_hash:
                        v = f"{base_ver}+git{commits_ahead}.{git_hash}"
                    else:
                        v = base_ver
                    print(f"generate_spec: Detected git describe version '{v}'.")
                    return v
                elif re.match(r"^[0-9a-f]{7,40}$", raw_desc):
                    v = f"0.0.0+git.{raw_desc[:7]}"
                    print(f"generate_spec: Detected git commit version '{v}'.")
                    return v
        except Exception:
            pass

    # Tier 3: Check source archive filename (e.g. croc-10.1.1.tar.gz)
    for p in search_dirs:
        for archive in list(p.glob("*.tar.*")) + list(p.glob("*.tar")):
            m = re.search(r"(?:_service:[^:]+:)?([a-zA-Z0-9_\-]+)-([0-9]+(?:\.[0-9]+)*(?:\+git[0-9a-f\.]*)?)\.tar", archive.name)
            if m:
                v = m.group(2)
                print(f"generate_spec: Detected version '{v}' from archive '{archive.name}'.")
                return v

    return "@VERSION@"


def main():
    parser = argparse.ArgumentParser(
        description="obs-service-generate_spec: Umbrella RPM Spec Generator for Open Build Service"
    )
    parser.add_argument("--outdir", required=True, help="Directory to output generated files (mandatory)")
    parser.add_argument("--name", default=None, help="Package name override")
    parser.add_argument("--version", default="@VERSION@", help="Package version override")
    parser.add_argument("--compression", default="zst", choices=["zst", "xz", "gz"], help="Vendor archive compression")
    parser.add_argument("--flavor", default=None, help="Force specific flavor (e.g. go, rust, python)")
    parser.add_argument("--vendor", default="auto", choices=["auto", "enable", "disable"], help="Vendor mode")
    parser.add_argument("--source-dir", default=None, help="Root directory of unpacked source code")
    parser.add_argument("--plugin-dir", default=None, help="Custom plugin directory")

    args, unknown = parser.parse_known_args()

    outdir = Path(args.outdir).resolve()
    outdir.mkdir(parents=True, exist_ok=True)

    source_dir = locate_source_directory(args.source_dir)
    print(f"generate_spec: Checking source directory '{source_dir}'...")

    # Step 1: No-Op Guard
    existing_spec = check_existing_spec(source_dir)
    if existing_spec:
        print(f"generate_spec: Existing spec file found ('{existing_spec}'). Skipping spec generation.")
        sys.exit(0)

    # Step 2: Plugin Discovery
    plugin_dirs = get_plugin_directories(args.plugin_dir)
    plugins = collect_plugins(plugin_dirs)

    if not plugins:
        print("generate_spec: No plugins found or all plugins masked.")
        sys.exit(0)

    # Step 3: Match and Dispatch
    resolved_version = resolve_version(source_dir, args.version)

    for prio, manifest_mask, plugin_exec in plugins:
        # Check flavor filter if provided
        if args.flavor:
            flavor_name = plugin_exec.stem.replace("_generator", "")
            if args.flavor.lower() not in [flavor_name.lower(), manifest_mask.lower()]:
                continue

        manifest_path = source_dir / manifest_mask
        if manifest_path.is_file():
            print(f"generate_spec: Matched generator '{plugin_exec.name}' (priority {prio}) for '{manifest_mask}'.")
            cmd = [
                str(plugin_exec),
                "--manifest-path", str(manifest_path),
                "--source-dir", str(source_dir),
                "--outdir", str(outdir),
                "--compression", args.compression,
                "--vendor", args.vendor,
                "--version", resolved_version,
            ]
            if args.name:
                cmd.extend(["--name", args.name])

            # Forward any additional arguments
            cmd.extend(unknown)

            res = subprocess.run(cmd)
            sys.exit(res.returncode)

    print("generate_spec: No matching manifest found for spec generation.")
    sys.exit(0)


if __name__ == "__main__":
    main()
